@@ -13,22 +13,23 @@
  */
 @theme {
   /* Fondo cálido y texto principal (contraste > 14:1). */
-  --color-cream: #fff8f1;
+  --color-cream: #fff6f1;
   --color-ink: #2a1a20;
   /* Texto secundario. Sobre `cream` tiene contraste ≈ 5.9:1 (cumple WCAG AA). */
   --color-muted: #6f5b63;
   /* Bordes y separadores suaves. */
-  --color-line: #f0e0d8;
+  --color-line: #f3e0d6;
 
-  /* Color de marca (rosa). 600 con texto blanco tiene contraste ≈ 5:1 (cumple WCAG AA). */
-  --color-brand-50: #fff1f3;
-  --color-brand-100: #ffe0e6;
-  --color-brand-500: #e8456b;
-  --color-brand-600: #d02a56;
-  --color-brand-700: #ae1f45;
+  /* Color de marca: dorado y durazno del logo. 600 con texto blanco tiene contraste ≈ 4.9:1 y
+     700 sobre `cream` ≈ 6.3:1 (cumplen WCAG AA). 50 y 100 son los duraznos del fondo del logo. */
+  --color-brand-50: #fff3ee;
+  --color-brand-100: #ffe4dd;
+  --color-brand-500: #c9962a;
+  --color-brand-600: #946a17;
+  --color-brand-700: #7c5410;
 
   /* Acento dorado para detalles. */
-  --color-gold: #f5b942;
+  --color-gold: #d9a830;
 
   /* Verde de WhatsApp oscurecido para que el texto blanco sea legible (≈ 5:1). */
   --color-whatsapp: #15803d;
