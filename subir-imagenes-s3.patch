diff --git a/src/infrastructure/storage/storage-provider.ts b/src/infrastructure/storage/storage-provider.ts
index e69de29..141822c 100644
--- a/src/infrastructure/storage/storage-provider.ts
+++ b/src/infrastructure/storage/storage-provider.ts
@@ -0,0 +1,38 @@
+import { PutObjectCommand, S3Client } from '@aws-sdk/client-s3';
+
+export interface ImageStorage {
+  /** Guarda el archivo y devuelve la URL pública que se guarda en la BD. */
+  put(key: string, body: Uint8Array, contentType: string): Promise<string>;
+}
+
+let cached: ImageStorage | null | undefined;
+
+/**
+ * Devuelve el almacenamiento S3, o null si no está configurado (S3_BUCKET / AWS_REGION vacíos).
+ * Las credenciales las toma solas del rol IAM de la instancia EC2 (no hay claves en el código).
+ */
+export function getImageStorage(): ImageStorage | null {
+  if (cached !== undefined) return cached;
+  const bucket = process.env.S3_BUCKET?.trim();
+  const region = process.env.AWS_REGION?.trim();
+  if (!bucket || !region) return (cached = null);
+
+  const base = (process.env.S3_PUBLIC_BASE_URL?.trim() || `https://${bucket}.s3.${region}.amazonaws.com`).replace(/\/+$/, '');
+  const client = new S3Client({ region });
+
+  cached = {
+    async put(key, body, contentType) {
+      await client.send(
+        new PutObjectCommand({
+          Bucket: bucket,
+          Key: key,
+          Body: body,
+          ContentType: contentType,
+          CacheControl: 'public, max-age=31536000, immutable',
+        }),
+      );
+      return `${base}/${key}`;
+    },
+  };
+  return cached;
+}
diff --git a/src/lib/admin-api-client.ts b/src/lib/admin-api-client.ts
index 4cd67cf..270d044 100644
--- a/src/lib/admin-api-client.ts
+++ b/src/lib/admin-api-client.ts
@@ -105,3 +105,29 @@ export async function adminRequest<T = void>(method: Method, path: string, body?
   if (!response.ok) throw toAdminApiError(response.status, data);
   return data as T;
 }
+
+/**
+ * Sube una imagen a POST /api/uploads (multipart) y devuelve la URL pública que genera S3.
+ * No se fija Content-Type a mano: el navegador añade el "boundary" correcto.
+ *
+ * @throws AdminApiError si falla la subida o no hay conexión.
+ */
+export async function adminUpload(file: File): Promise<{ url: string }> {
+  const form = new FormData();
+  form.append("file", file);
+
+  let response: Response;
+  try {
+    response = await fetch("/api/uploads", { method: "POST", credentials: "same-origin", body: form });
+  } catch {
+    throw new AdminApiError(0, "NETWORK_ERROR", "No se pudo conectar con el servidor. Revisa tu conexión.");
+  }
+
+  const data: unknown = await response.json().catch(() => null);
+  if (!response.ok) {
+    const error = toAdminApiError(response.status, data);
+    // La validación del archivo viene como detalle del campo "file": mostrarlo como mensaje.
+    throw new AdminApiError(error.status, error.code, error.fieldErrors.file ?? error.message, error.fieldErrors);
+  }
+  return data as { url: string };
+}
