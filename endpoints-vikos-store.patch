+  font-family: var(--font-sans);
+}
+
+/*
+ * Foco visible para quienes navegan con teclado. Se aplica a TODOS los elementos
+ * interactivos para no tener que repetirlo en cada componente.
+ */
+:where(a, button, summary, input, select, textarea):focus-visible {
+  outline: 3px solid var(--color-brand-500);
+  outline-offset: 2px;
+}
+
+/* Quien pidió "reducir movimiento" en su sistema no ve animaciones. */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    transition-duration: 0.01ms !important;
+  }
 }
