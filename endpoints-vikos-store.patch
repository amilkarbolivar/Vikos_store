@@ -0,0 +1,5 @@
+/** Recorta un texto a `max` caracteres agregando "…" (para descripciones de buscadores). */
+export function truncate(text: string, max = 160): string {
+  const clean = text.replace(/\s+/g, " ").trim();
+  return clean.length <= max ? clean : `${clean.slice(0, max - 1).trimEnd()}…`;
+}
diff --git a/src/lib/whatsapp.ts b/src/lib/whatsapp.ts
new file mode 100644
index 0000000..86095b6
--- /dev/null
+++ b/src/lib/whatsapp.ts
@@ -0,0 +1,64 @@
+import { formatPrice } from "./format-price";
+
+/**
+ * ============================================================================
+ * UTILIDADES DE WHATSAPP
+ * ============================================================================
+ * Funciones puras (sin React ni variables de entorno): reciben todo por parámetro,
+ * así se pueden probar y reutilizar. Los componentes se encargan de pasarles la
+ * configuración de `siteConfig`.
+ */
+
+/**
+ * Arma el enlace que abre WhatsApp con un mensaje ya escrito.
+ *
+ * Usa el formato oficial `https://wa.me/<número>?text=<mensaje>`:
+ * - En celular abre la app; en computador abre WhatsApp Web.
+ * - El número debe ir solo con dígitos (se limpian "+", espacios y guiones).
+ * - El mensaje se codifica para que los saltos de línea, tildes y emojis viajen bien.
+ */
+export function buildWhatsAppUrl(phone: string, message: string): string {
+  const digits = phone.replace(/\D/g, "");
+  return `https://wa.me/${digits}?text=${encodeURIComponent(message)}`;
+}
+
+/** Datos mínimos de un producto necesarios para escribir el mensaje. */
+interface ProductForMessage {
+  name: string;
+  /** Precio en pesos. */
+  price: number;
+  slug: string;
+}
+
+interface ProductMessageOptions {
+  /** URL pública del sitio, sin barra final (para armar el enlace del producto). */
+  siteUrl: string;
+  greeting: string;
+  closing: string;
+}
+
+/**
+ * Escribe el mensaje que el cliente enviará por un producto. Resultado de ejemplo:
+ *
+ *   Hola 👋, me interesa este regalo:
+ *
+ *   🎁 Oso grande
+ *   💰 $ 89.900
+ *   🔗 https://mitienda.com/productos/oso-grande
+ *
+ *   ¿Me confirmas disponibilidad y tiempo de entrega?
+ */
+export function buildProductMessage(
+  product: ProductForMessage,
+  { siteUrl, greeting, closing }: ProductMessageOptions,
+): string {
+  return [
+    greeting,
+    "",
+    `🎁 ${product.name}`,
+    `💰 ${formatPrice(product.price)}`,
+    `🔗 ${siteUrl}/productos/${product.slug}`,
+    "",
+    closing,
+  ].join("\n");
+}
diff --git a/src/modules/auth/infrastructure/admin-user-delegate.ts b/src/modules/auth/infrastructure/admin-user-delegate.ts
new file mode 100644
index 0000000..ed9406a
--- /dev/null
+++ b/src/modules/auth/infrastructure/admin-user-delegate.ts
@@ -0,0 +1,40 @@
+/**
+ * Adaptador entre la tabla REAL `users` de Prisma (snake_case, con columna `role`) y el
+ * `AdminUserDelegate` que espera `PrismaAuthRepository`.
+ *
+ * Solo se consideran usuarios con `role = 'ADMIN'`: cualquier otro rol se trata como si no
+ * existiera, de modo que no pueda iniciar sesión en el panel.
+ */
+
+import type { PrismaClient } from "@prisma/client";
+
+import type { AdminUserDelegate, AdminUserRow } from "./auth-repository-impl.ts";
+
+interface UsersRecord {
+  id: string;
+  email: string;
+  password_hash: string;
+  is_active: boolean;
+  created_at: Date;
+  updated_at: Date;
+}
+
+function toRow(record: UsersRecord): AdminUserRow {
+  return {
+    id: record.id,
+    email: record.email,
+    passwordHash: record.password_hash,
+    isActive: record.is_active,
+    createdAt: record.created_at,
+    updatedAt: record.updated_at,
+  };
+}
+
+export function createAdminUserDelegate(prisma: PrismaClient): AdminUserDelegate {
+  return {
+    async findUnique({ where }) {
+      const record = await prisma.users.findFirst({ where: { ...where, role: "ADMIN" } });
+      return record ? toRow(record) : null;
+    },
+  };
+}
diff --git a/src/modules/auth/infrastructure/hmac-session-service.ts b/src/modules/auth/infrastructure/hmac-session-service.ts
new file mode 100644
index 0000000..8d28b1f
--- /dev/null
+++ b/src/modules/auth/infrastructure/hmac-session-service.ts
@@ -0,0 +1,75 @@
+/**
+ * Implementación de `SessionService` con tokens firmados con HMAC-SHA256 (solo `node:crypto`,
+ * sin dependencias nuevas).
+ *
+ * Formato del token: `base64url(payload).base64url(firma)`, con payload `{ sub, exp }`
+ * (`exp` en segundos Unix). La firma cubre el payload completo, así que no se puede cambiar el
+ * usuario ni la expiración sin conocer `SESSION_SECRET`. La firma se compara en tiempo constante.
+ *
+ * Limitación conocida: es una sesión "sin estado"; no se puede revocar un token concreto antes
+ * de que expire. Mitigación: `GetCurrentAdmin` consulta el usuario en cada petición, así que
+ * desactivar a un administrador corta su acceso de inmediato, y la duración es corta.
+ */
+
+import { createHmac, timingSafeEqual } from "node:crypto";
+
+import type { CreatedSession, SessionService } from "../domain/session-service.ts";
+
+export const DEFAULT_SESSION_TTL_MS = 8 * 60 * 60 * 1000; // 8 horas
+
+export interface HmacSessionServiceOptions {
+  /** Secreto de firma (`SESSION_SECRET`, mínimo 32 caracteres). */
+  secret: string;
+  ttlMs?: number;
+  /** Reloj inyectable para las pruebas. */
+  now?: () => number;
+}
+
+function base64url(input: Buffer | string): string {
+  return Buffer.from(input).toString("base64url");
+}
+
+export class HmacSessionService implements SessionService {
+  private readonly secret: string;
+  private readonly ttlMs: number;
+  private readonly now: () => number;
+
+  constructor(options: HmacSessionServiceOptions) {
+    this.secret = options.secret;
+    this.ttlMs = options.ttlMs ?? DEFAULT_SESSION_TTL_MS;
+    this.now = options.now ?? Date.now;
+  }
+
+  async create(userId: string): Promise<CreatedSession> {
+    const expiresAt = new Date(this.now() + this.ttlMs);
+    const payload = base64url(
+      JSON.stringify({ sub: userId, exp: Math.floor(expiresAt.getTime() / 1000) }),
+    );
+    return { token: `${payload}.${this.sign(payload)}`, expiresAt };
+  }
+
+  async verify(token: string): Promise<{ userId: string } | null> {
+    const parts = token.split(".");
+    if (parts.length !== 2) return null;
+    const [payload, signature] = parts as [string, string];
+
+    const expected = Buffer.from(this.sign(payload));
+    const received = Buffer.from(signature);
+    if (expected.length !== received.length || !timingSafeEqual(expected, received)) return null;
+
+    try {
+      const claims: unknown = JSON.parse(Buffer.from(payload, "base64url").toString("utf8"));
+      if (typeof claims !== "object" || claims === null) return null;
+      const { sub, exp } = claims as { sub?: unknown; exp?: unknown };
+      if (typeof sub !== "string" || typeof exp !== "number") return null;
+      if (exp * 1000 <= this.now()) return null;
+      return { userId: sub };
+    } catch {
+      return null;
+    }
+  }
+
+  private sign(payload: string): string {
+    return createHmac("sha256", this.secret).update(payload).digest("base64url");
+  }
+}
