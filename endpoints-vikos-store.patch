+import { ForbiddenError, UnauthorizedError, ValidationError } from '../domain/errors';
+import { isUuid } from '../domain/uuid';
+
+/** Contrato de `requireAdmin`: lanza UnauthorizedError (401) o ForbiddenError (403). */
+export type RequireAdmin = (request: Request) => Promise<unknown>;
+
+/**
+ * Pregunta si quien llama es administrador SIN rechazar la petición: sirve para endpoints
+ * públicos que muestran más datos a un administrador. Solo absorbe 401/403; cualquier otro
+ * error (por ejemplo, la base de datos caída) se propaga.
+ */
+export async function isAdminRequest(
+  requireAdmin: RequireAdmin | undefined,
+  request: Request,
+): Promise<boolean> {
+  if (!requireAdmin) return false;
+  try {
+    await requireAdmin(request);
+    return true;
+  } catch (error) {
+    if (error instanceof UnauthorizedError || error instanceof ForbiddenError) return false;
+    throw error;
+  }
+}
+
+/**
+ * Lee `?includeInactive=true|false`. Devuelve `true` solo si se pidió y quien llama es
+ * administrador; si lo pide un anónimo, lanza 401 (no se ignora en silencio).
+ */
+export async function wantsInactive(
+  request: Request,
+  requireAdmin: RequireAdmin | undefined,
+): Promise<boolean> {
+  const raw = new URL(request.url).searchParams.get('includeInactive');
+  if (raw === null || raw === 'false') return false;
+  if (raw !== 'true') {
+    throw new ValidationError([
+      { field: 'includeInactive', message: 'includeInactive debe ser true o false' },
+    ]);
+  }
+  if (!requireAdmin) throw new UnauthorizedError();
+  await requireAdmin(request);
+  return true;
+}
+
+/** Valida un identificador de la ruta que debe ser UUID (operaciones sobre un registro concreto). */
+export function requireUuidParam(value: string, field = 'id'): string {
+  if (!isUuid(value)) {
+    throw new ValidationError([{ field, message: 'El identificador debe ser un UUID válido' }]);
+  }
+  return value;
+}
diff --git a/src/modules/shared/presentation/http-error-mapper.ts b/src/modules/shared/presentation/http-error-mapper.ts
new file mode 100644
index 0000000..0ae363e
--- /dev/null
+++ b/src/modules/shared/presentation/http-error-mapper.ts
@@ -0,0 +1,94 @@
+import {
+  AppError,
+  BusinessRuleError,
+  ConflictError,
+  ForbiddenError,
+  NotFoundError,
+  PayloadTooLargeError,
+  UnauthorizedError,
+  ValidationError,
+  type ValidationIssue,
+} from '../domain/errors';
+
+export interface HttpErrorBody {
+  error: {
+    code: string;
+    message: string;
+    details?: ValidationIssue[];
+  };
+}
+
+export interface ErrorLogger {
+  error(message: string, meta?: Record<string, unknown>): void;
+}
+
+/** Traduce los errores propios de un módulo. Devuelve `undefined` si no los reconoce. */
+export type ModuleErrorMapper = (error: unknown) => Response | undefined;
+
+export interface ToErrorResponseOptions {
+  /** Nombre del recurso para el log del 500 (por ejemplo "productos"). */
+  context?: string;
+  /** Errores específicos del módulo (por ejemplo un slug repetido con su campo). */
+  mapModuleError?: ModuleErrorMapper;
+}
+
+export function errorBody(
+  code: string,
+  message: string,
+  details?: ValidationIssue[],
+): HttpErrorBody {
+  return { error: { code, message, ...(details ? { details } : {}) } };
+}
+
+/**
+ * Traduce cualquier error a una respuesta HTTP.
+ * Los errores no reconocidos devuelven un 500 genérico: nunca se expone el mensaje original,
+ * trazas ni datos de conexión. En el log solo se escribe el tipo y el código del error.
+ */
+export function toErrorResponse(
+  error: unknown,
+  logger?: ErrorLogger,
+  options: ToErrorResponseOptions = {},
+): Response {
+  if (error instanceof ValidationError) {
+    return Response.json(errorBody(error.code, 'Los datos enviados no son válidos', error.issues), {
+      status: 400,
+    });
+  }
+  if (error instanceof PayloadTooLargeError) {
+    return Response.json(errorBody(error.code, error.message), { status: 413 });
+  }
+  if (error instanceof UnauthorizedError) {
+    return Response.json(errorBody(error.code, error.message), { status: 401 });
+  }
+  if (error instanceof ForbiddenError) {
+    return Response.json(errorBody(error.code, error.message), { status: 403 });
+  }
+  if (error instanceof NotFoundError) {
+    return Response.json(errorBody(error.code, error.message), { status: 404 });
+  }
+  if (error instanceof ConflictError) {
+    return Response.json(errorBody(error.code, error.message), { status: 409 });
+  }
+  if (error instanceof BusinessRuleError) {
+    return Response.json(errorBody(error.code, error.message), { status: 422 });
+  }
+
+  const moduleResponse = options.mapModuleError?.(error);
+  if (moduleResponse) return moduleResponse;
+
+  const cause = error instanceof Error ? error.cause : undefined;
+  logger?.error(
+    `Error no controlado al procesar la petición de ${options.context ?? 'la API'}`,
+    {
+      errorName: error instanceof Error ? error.name : typeof error,
+      errorCode: error instanceof AppError ? error.code : undefined,
+      causeName: cause instanceof Error ? cause.name : undefined,
+      causeCode:
+        typeof cause === 'object' && cause !== null && 'code' in cause
+          ? String((cause as { code: unknown }).code)
+          : undefined,
+    },
+  );
+  return Response.json(errorBody('INTERNAL_ERROR', 'Error interno del servidor'), { status: 500 });
+}
diff --git a/src/modules/shared/presentation/read-json-body.ts b/src/modules/shared/presentation/read-json-body.ts
new file mode 100644
index 0000000..0a4d1a0
--- /dev/null
+++ b/src/modules/shared/presentation/read-json-body.ts
@@ -0,0 +1,30 @@
+import { PayloadTooLargeError, ValidationError } from '../domain/errors';
+
+export const MAX_BODY_BYTES = 100_000;
+
+/** Lee el cuerpo como JSON con un tope de tamaño. Lanza ValidationError / PayloadTooLargeError. */
+export async function readJsonBody(request: Request): Promise<unknown> {
+  const declaredLength = Number(request.headers.get('content-length') ?? 0);
+  if (declaredLength > MAX_BODY_BYTES) {
+    throw new PayloadTooLargeError();
+  }
+
+  const text = await request.text();
+  if (text.length > MAX_BODY_BYTES) {
+    throw new PayloadTooLargeError();
+  }
+
+  try {
+    return JSON.parse(text);
+  } catch {
+    throw new ValidationError([{ field: 'body', message: 'El cuerpo debe ser JSON válido' }]);
+  }
+}
+
+/** Exige un objeto JSON plano (no arreglo, no null) y lo devuelve como registro. */
+export function requireJsonObject(body: unknown): Record<string, unknown> {
+  if (typeof body !== 'object' || body === null || Array.isArray(body)) {
+    throw new ValidationError([{ field: 'body', message: 'El cuerpo debe ser un objeto JSON' }]);
+  }
+  return body as Record<string, unknown>;
+}
diff --git a/src/services/catalog-service.ts b/src/services/catalog-service.ts
new file mode 100644
